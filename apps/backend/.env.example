# ================================================
# RENJANA BACKEND — Environment Variables Template
# ================================================

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

JWT_SECRET=renjana-jwt-secret-dev-please-change-in-production-min-32-chars
JWT_REFRESH_SECRET=renjana-refresh-secret-dev-please-change-in-production-min-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

OPENAI_API_KEY=sk-...

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=Renjana

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Auth cookies (httpOnly). SameSite defaults: lax (dev), none (production).
# Secure defaults to true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
