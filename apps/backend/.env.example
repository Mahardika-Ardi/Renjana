# ================================================
# RENJANA BACKEND — Environment Variables Template
# ================================================

# ---- App ----------------------------------------
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ---- JWT ----------------------------------------
JWT_SECRET=renjana-jwt-secret-dev-please-change-in-production-min-32-chars
JWT_REFRESH_SECRET=renjana-refresh-secret-dev-please-change-in-production-min-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Database (Supabase PostgreSQL) -------------
# Dapatkan dari Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# Note: Pilih "Transaction" mode / Port 5432 untuk DATABASE_URL & DIRECT_DATABASE_URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# ---- Supabase -----------------------------------
# Dapatkan dari Supabase Dashboard -> Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---- OpenAI (AI Emotion Translation) -----------
OPENAI_API_KEY=sk-...

# ---- Resend (Email) -----------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@renjana.app
RESEND_FROM_NAME=Renjana

# ---- Rate Limiting ------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
